{
  "name": "calculadora-rentabilidade-acougue",
  "version": "1.0.0",
  "description": "Calculadora Web de Rendimento, Desossa, Custo Real e Controle de Estoque para Açougues",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node server.mjs",
    "app": "electron electron-main.cjs",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.acouguepro.calculadora",
    "productName": "AcouguePro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "server.mjs",
      "electron-main.cjs",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Açougue Pro"
    }
  },
  "keywords": [
    "acougue",
    "rendimento",
    "desossa",
    "rentabilidade",
    "custo-real",
    "estoque"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
